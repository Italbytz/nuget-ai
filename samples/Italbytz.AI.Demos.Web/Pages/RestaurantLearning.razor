@page "/restaurant-learning"
@using Italbytz.AI.Demos.Web.Demos

<PageTitle>Restaurant learning demo</PageTitle>

<section class="demo-hero">
    <div>
        <p class="eyebrow">Learning demo</p>
        <h1>Restaurant: ID3 vs CART</h1>
        <p class="hero-copy">Compare classic decision-tree learning on the AIMA restaurant dataset. This page contrasts information-gain splits with a gini-based CART-style learner integrated into Italbytz.AI.Learning.</p>
    </div>

    <div class="stat-grid">
        <article>
            <span class="stat-label">Dataset</span>
            <strong>Restaurant (12 examples)</strong>
        </article>
        <article>
            <span class="stat-label">ID3 accuracy</span>
            <strong>@FormatAccuracy(_comparison.Id3.Accuracy)</strong>
        </article>
        <article>
            <span class="stat-label">CART accuracy</span>
            <strong>@FormatAccuracy(_comparison.Cart.Accuracy)</strong>
        </article>
        <article>
            <span class="stat-label">Agreement</span>
            <strong>@AgreementLabel</strong>
        </article>
    </div>
</section>

<section class="control-panel">
    <div class="secondary-controls">
        <div class="selection-copy">
            <p class="selection-summary">@_comparison.Summary</p>
            <p class="selection-summary">Use refresh to rebuild from the package-level learner implementations after changes in nuget-ai.</p>
            <p class="selection-summary">Click a prediction row to highlight its traversed path in both learned trees.</p>
        </div>

        <div class="step-buttons">
            <button class="ghost-button" @onclick="Refresh">Refresh comparison</button>
        </div>
    </div>
</section>

<section class="demo-grid">
    <article class="surface-card map-card">
        <div class="section-heading">
            <h2>ID3 tree</h2>
            <p>Learned split structure based on information gain.</p>
        </div>

        <GraphViewport Graph="@_comparison.Id3Tree.Graph"
                   ActiveNodeKeys="@(SelectedId3Path?.NodeIds ?? Array.Empty<string>())"
                   ActiveEdgeKeys="@(SelectedId3Path?.EdgeKeys ?? Array.Empty<string>())"
                   CurrentNodeKey="@SelectedId3Path?.LeafNodeId"
                       Title="ID3 decision tree"
                       ZoomInLabel="+"
                       ZoomOutLabel="-"
                       FitLabel="Fit"
                       ResetLabel="Reset"
                       InteractionHint="Inspect split nodes and branch labels to explain each decision path."
                       ActiveLegendLabel="Active"
                       SuccessorLegendLabel="Successor"
                       CurrentNodeLegendLabel="Current"
                       FrontierLegendLabel="Frontier"
                       ExploredLegendLabel="Explored"
                       SolutionLegendLabel="Solution"
                       DefaultLegendLabel="Default"
                       InspectorTitle="Inspector"
                       NoSelectionTitle="Nothing selected"
                       NoSelectionText="Select a node or edge to inspect the subtree structure."
                       NodeLabel="Node"
                       EdgeLabel="Edge"
                       WeightLabel="Value"
                       ConnectionsLabel="Connections"
                       StateLabel="State" />
    </article>

    <article class="surface-card map-card">
        <div class="section-heading">
            <h2>CART tree</h2>
            <p>Learned split structure based on gini impurity.</p>
        </div>

        <GraphViewport Graph="@_comparison.CartTree.Graph"
                   ActiveNodeKeys="@(SelectedCartPath?.NodeIds ?? Array.Empty<string>())"
                   ActiveEdgeKeys="@(SelectedCartPath?.EdgeKeys ?? Array.Empty<string>())"
                   CurrentNodeKey="@SelectedCartPath?.LeafNodeId"
                       Title="CART decision tree"
                       ZoomInLabel="+"
                       ZoomOutLabel="-"
                       FitLabel="Fit"
                       ResetLabel="Reset"
                       InteractionHint="Compare branch depth and terminal decisions against the ID3 model."
                       ActiveLegendLabel="Active"
                       SuccessorLegendLabel="Successor"
                       CurrentNodeLegendLabel="Current"
                       FrontierLegendLabel="Frontier"
                       ExploredLegendLabel="Explored"
                       SolutionLegendLabel="Solution"
                       DefaultLegendLabel="Default"
                       InspectorTitle="Inspector"
                       NoSelectionTitle="Nothing selected"
                       NoSelectionText="Select a node or edge to inspect the subtree structure."
                       NodeLabel="Node"
                       EdgeLabel="Edge"
                       WeightLabel="Value"
                       ConnectionsLabel="Connections"
                       StateLabel="State" />
    </article>

    <article class="surface-card inspector-card">
        <div class="section-heading">
            <h2>Prediction diff</h2>
            <p>Inspect per-example outputs to see where split criteria diverge.</p>
        </div>

        <table>
            <thead>
                <tr>
                    <th>#</th>
                    @foreach (var feature in _comparison.FeatureNames)
                    {
                        <th>@feature</th>
                    }
                    <th>Actual</th>
                    <th>ID3</th>
                    <th>CART</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _comparison.Rows)
                {
                    var same = string.Equals(row.Id3Prediction, row.CartPrediction, StringComparison.Ordinal);
                    <tr class="@(GetRowCss(same, row.Index))" @onclick="() => SelectRow(row.Index)">
                        <td>@row.Index</td>
                        @foreach (var featureValue in row.FeatureValues)
                        {
                            <td>@featureValue</td>
                        }
                        <td>@row.Actual</td>
                        <td>@row.Id3Prediction</td>
                        <td>@row.CartPrediction</td>
                        <td>@(same ? "same" : "different")</td>
                    </tr>
                }
            </tbody>
        </table>
    </article>
</section>

@code {
    private RestaurantLearningComparison _comparison = RestaurantLearningDemo.Build();
    private int? _selectedRowIndex;

    private RestaurantDecisionPath? SelectedId3Path => TryGetPath(_comparison.Id3Tree, _selectedRowIndex);

    private RestaurantDecisionPath? SelectedCartPath => TryGetPath(_comparison.CartTree, _selectedRowIndex);

    private string AgreementLabel
        => _comparison.Rows.Count == 0
            ? "0 / 0"
            : $"{_comparison.Rows.Count(row => string.Equals(row.Id3Prediction, row.CartPrediction, StringComparison.Ordinal))} / {_comparison.Rows.Count}";

    private static string FormatAccuracy(double value)
    {
        return value.ToString("0.0%", System.Globalization.CultureInfo.InvariantCulture);
    }

    private void Refresh()
    {
        _comparison = RestaurantLearningDemo.Build();
        _selectedRowIndex = null;
    }

    private void SelectRow(int rowIndex)
    {
        _selectedRowIndex = _selectedRowIndex == rowIndex ? null : rowIndex;
    }

    private static RestaurantDecisionPath? TryGetPath(RestaurantTreeView tree, int? rowIndex)
    {
        if (!rowIndex.HasValue)
        {
            return null;
        }

        return tree.PathsByRow.TryGetValue(rowIndex.Value, out var path) ? path : null;
    }

    private string GetRowCss(bool same, int rowIndex)
    {
        var baseClass = same ? "applicable-row" : "blocked-row";
        return _selectedRowIndex == rowIndex ? $"{baseClass} selected-row" : baseClass;
    }
}
