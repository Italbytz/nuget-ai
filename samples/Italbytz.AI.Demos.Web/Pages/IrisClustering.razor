@page "/iris-clustering"
@using Italbytz.AI.Demos.Web.Demos
@implements IAsyncDisposable
@inject IJSRuntime JS

<PageTitle>Iris clustering demo</PageTitle>

<section class="demo-hero">
    <div>
        <p class="eyebrow">Clustering demo</p>
        <h1>Iris: k-Means (k=3)</h1>
        <p class="hero-copy">Unsupervised k-Means clustering on the classic UCI Iris dataset. Each flower is assigned to one of three clusters based on sepal and petal measurements, without using the species label during training.</p>
    </div>

    <div class="stat-grid">
        <article>
            <span class="stat-label">Dataset</span>
            <strong>Iris (30 examples)</strong>
        </article>
        <article>
            <span class="stat-label">Clusters</span>
            <strong>3</strong>
        </article>
        <article>
            <span class="stat-label">Purity</span>
            <strong>@FormatPercent(_result.Purity)</strong>
        </article>
        <article>
            <span class="stat-label">Correct / Total</span>
            <strong>@_result.Correct / @_result.Total</strong>
        </article>
    </div>
</section>

<section class="control-panel">
    <div class="secondary-controls">
        <div class="selection-copy">
            <p class="selection-summary">@_result.Summary</p>
            <p class="selection-summary">Use refresh to re-run clustering after package changes.</p>
        </div>
        <div class="step-buttons">
            <button class="ghost-button" @onclick="Refresh">Refresh</button>
        </div>
    </div>
</section>

<section class="demo-grid">
    <article class="surface-card map-card">
        <div class="section-heading">
            <h2>D3 cluster plot</h2>
            <p>Interactive scatter projection with animated centroid iterations. Color indicates cluster, symbol indicates true species.</p>
        </div>

        <div class="axis-controls">
            <label>
                X-Axis
                <select @bind="_xAxis">
                    @foreach (var feature in _featureOptions)
                    {
                        <option value="@feature.Key">@feature.Label</option>
                    }
                </select>
            </label>

            <label>
                Y-Axis
                <select @bind="_yAxis">
                    @foreach (var feature in _featureOptions)
                    {
                        <option value="@feature.Key">@feature.Label</option>
                    }
                </select>
            </label>
        </div>

        <div class="animation-controls">
            <button class="ghost-button" @onclick="PlayAnimation">Play</button>
            <button class="ghost-button" @onclick="PauseAnimation">Pause</button>
            <button class="ghost-button" @onclick="StepAnimation">Step</button>
            <button class="ghost-button" @onclick="ReplayAnimation">Replay</button>
        </div>

        <div class="iris-d3-host" @ref="_chartHost"></div>
    </article>

    <article class="surface-card inspector-card">
        <div class="section-heading">
            <h2>Cluster centroids</h2>
            <p>Each centroid is the mean position of all assigned examples. The dominant species shows which class dominates that cluster.</p>
        </div>

        <table>
            <thead>
                <tr>
                    <th>Cluster</th>
                    <th>Sepal L</th>
                    <th>Sepal W</th>
                    <th>Petal L</th>
                    <th>Petal W</th>
                    <th>Dominant species</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in _result.Centroids)
                {
                    <tr>
                        <td>@c.ClusterId</td>
                        <td>@c.SepalLength</td>
                        <td>@c.SepalWidth</td>
                        <td>@c.PetalLength</td>
                        <td>@c.PetalWidth</td>
                        <td>@c.DominantSpecies</td>
                    </tr>
                }
            </tbody>
        </table>
    </article>

    <article class="surface-card inspector-card">
        <div class="section-heading">
            <h2>Per-example assignments</h2>
            <p>True species label vs. assigned cluster id for each example.</p>
        </div>

        <table>
            <thead>
                <tr>
                    <th>#</th>
                    <th>Sepal L</th>
                    <th>Sepal W</th>
                    <th>Petal L</th>
                    <th>Petal W</th>
                    <th>True species</th>
                    <th>Cluster</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _result.Rows)
                {
                    <tr>
                        <td>@row.Index</td>
                        <td>@FormatNumber(row.SepalLength)</td>
                        <td>@FormatNumber(row.SepalWidth)</td>
                        <td>@FormatNumber(row.PetalLength)</td>
                        <td>@FormatNumber(row.PetalWidth)</td>
                        <td>@row.TrueSpecies</td>
                        <td>@row.ClusterId</td>
                    </tr>
                }
            </tbody>
        </table>
    </article>
</section>

@code {
    private IrisClusteringResult _result = IrisClusteringDemo.Build();
    private readonly IReadOnlyList<(string Key, string Label)> _featureOptions =
    [
        ("sepal_length", "Sepal Length"),
        ("sepal_width", "Sepal Width"),
        ("petal_length", "Petal Length"),
        ("petal_width", "Petal Width")
    ];
    private string _xAxis = "petal_length";
    private string _yAxis = "petal_width";
    private ElementReference _chartHost;
    private IJSObjectReference? _d3Module;

    private static string FormatPercent(double value)
        => value.ToString("0.0%", System.Globalization.CultureInfo.InvariantCulture);

    private static string FormatNumber(double value)
        => value.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _d3Module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/irisClusteringD3.js");
        }

        if (_d3Module is not null)
        {
            await _d3Module.InvokeVoidAsync("renderIrisClustering", _chartHost, BuildChartPayload());
        }
    }

    private object BuildChartPayload()
    {
        return new
        {
            xAxis = _xAxis,
            yAxis = _yAxis,
            points = _result.Rows.Select(row => new
            {
                index = row.Index,
                sepal_length = row.SepalLength,
                sepal_width = row.SepalWidth,
                petal_length = row.PetalLength,
                petal_width = row.PetalWidth,
                species = row.TrueSpecies,
                cluster = row.ClusterId
            }).ToArray(),
            centroids = _result.Centroids.Select(centroid => new
            {
                cluster = centroid.ClusterId,
                sepal_length = double.Parse(centroid.SepalLength, System.Globalization.CultureInfo.InvariantCulture),
                sepal_width = double.Parse(centroid.SepalWidth, System.Globalization.CultureInfo.InvariantCulture),
                petal_length = double.Parse(centroid.PetalLength, System.Globalization.CultureInfo.InvariantCulture),
                petal_width = double.Parse(centroid.PetalWidth, System.Globalization.CultureInfo.InvariantCulture)
            }).ToArray(),
            centroidFrames = _result.CentroidFrames.Select(frame => new
            {
                iteration = frame.Iteration,
                centroids = frame.Centroids.Select(centroid => new
                {
                    cluster = centroid.ClusterId,
                    sepal_length = centroid.SepalLength,
                    sepal_width = centroid.SepalWidth,
                    petal_length = centroid.PetalLength,
                    petal_width = centroid.PetalWidth
                }).ToArray()
            }).ToArray()
        };
    }

    private void Refresh()
    {
        _result = IrisClusteringDemo.Build();
    }

    private async Task PlayAnimation()
    {
        if (_d3Module is null)
        {
            return;
        }

        await _d3Module.InvokeVoidAsync("playIrisClustering", _chartHost);
    }

    private async Task PauseAnimation()
    {
        if (_d3Module is null)
        {
            return;
        }

        await _d3Module.InvokeVoidAsync("pauseIrisClustering", _chartHost);
    }

    private async Task ReplayAnimation()
    {
        if (_d3Module is null)
        {
            return;
        }

        await _d3Module.InvokeVoidAsync("replayIrisClustering", _chartHost);
    }

    private async Task StepAnimation()
    {
        if (_d3Module is null)
        {
            return;
        }

        await _d3Module.InvokeVoidAsync("stepIrisClustering", _chartHost);
    }

    public async ValueTask DisposeAsync()
    {
        if (_d3Module is not null)
        {
            await _d3Module.DisposeAsync();
        }
    }
}
